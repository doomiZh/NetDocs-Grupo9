                        <pagina_seis_conjunto_objetos_ethernet>
                            <pagina_seis_objeto_ethernet>Aqui podemos configurar y editar algunas cosas como la direccion ip y el servidor DNS</pagina_seis_objeto_ethernet>
                        </pagina_seis_conjunto_objetos_ethernet>
                    </pagina_seis_conjuntos_objetos_ethernet>
