        <!-- ADAPTADOR -->
        <pagina_seis_adaptador>
            <pagina_seis_titulo_adaptador>1. Adaptador de LAN inalámbrica Wi-Fi</pagina_seis_titulo_adaptador>
            <pagina_seis_descripcion_adaptador>Esta sección se refiere a tu tarjeta de red Wi-Fi (la antena que conecta tu PC a Internet sin cables).</pagina_seis_descripcion_adaptador>

            <pagina_seis_caracteristicas_adaptador>
                <pagina_seis_caracteristica_adaptador>
                    <pagina_seis_titulo_caracteristica>Sufijo DNS específico para la conexión:</pagina_seis_titulo_caracteristica>
                    <pagina_seis_puntos_caracteristicas>
                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>(Está vacío)</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Qué es: A veces, los routers asignan un nombre de dominio a la red (como "micasa.local"). Si está vacío, simplemente significa que tu router no está asignando un nombre específico a esta red. No es un problema.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>
                    </pagina_seis_puntos_caracteristicas>
                </pagina_seis_caracteristica_adaptador>

                <pagina_seis_caracteristica_adaptador>
                    <pagina_seis_titulo_caracteristica>Vínculo: dirección IPv6 local:</pagina_seis_titulo_caracteristica>
                    <pagina_seis_puntos_caracteristicas>
                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Tu valor: fe80::5946:6a24:ed21:5c25%12</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Qué es: Es la dirección IP en el formato moderno (IPv6). El término "Local" significa que esta dirección solo sirve para comunicarse con otros dispositivos dentro de tu misma red local, no para salir a Internet globalmente.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>
                    </pagina_seis_puntos_caracteristicas>
                </pagina_seis_caracteristica_adaptador>

                <pagina_seis_caracteristica_adaptador>
                    <pagina_seis_titulo_caracteristica>Dirección IPv4:</pagina_seis_titulo_caracteristica>
                    <pagina_seis_puntos_caracteristicas>
                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Tu valor: 10.50.0.30</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Qué es: Este es el dato más importante. Es la "matrícula" o identificación de tu ordenador dentro de la red de tu casa u oficina.</pagina_seis_caracteristica>

                                <pagina_seis_detalles_caracteristicas>
                                    <pagina_seis_detalle_caracteristica>
                                        <pagina_seis_detalle>10.50.0 indica la red a la que perteneces.</pagina_seis_detalle>
                                    </pagina_seis_detalle_caracteristica>

                                    <pagina_seis_detalle_caracteristica>
                                        <pagina_seis_detalle>.30 es el número específico de tu ordenador.</pagina_seis_detalle>
                                    </pagina_seis_detalle_caracteristica>
                                </pagina_seis_detalles_caracteristicas>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Nota: Las direcciones que empiezan por 10.x.x.x son redes privadas, muy comunes en oficinas o configuraciones específicas (a diferencia de las típicas 192.168.1.x de casa).</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>
                    </pagina_seis_puntos_caracteristicas>
                </pagina_seis_caracteristica_adaptador>

                <pagina_seis_caracteristica_adaptador>
                    <pagina_seis_titulo_caracteristica>Máscara de subred:</pagina_seis_titulo_caracteristica>
                    <pagina_seis_puntos_caracteristicas>
                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Tu valor: 255.255.255.0</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Qué es: Define el tamaño de la red.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>El 255.255.255 le dice al ordenador que la parte fija de la red es 10.50.0.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>El .0 final indica que los dispositivos pueden cambiar solo el último número (del 1 al 254).</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>
                    </pagina_seis_puntos_caracteristicas>
                </pagina_seis_caracteristica_adaptador>

                <pagina_seis_caracteristica_adaptador>
                    <pagina_seis_titulo_caracteristica>Puerta de enlace predeterminada:</pagina_seis_titulo_caracteristica>
                    <pagina_seis_puntos_caracteristicas>
                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Tu valor: 10.50.0.1</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Qué es: Esta es la dirección IP de tu Router.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>

                        <pagina_seis_punto_caracteristica>
                            <pagina_seis_caracteristica>Se llama "puerta de enlace" (Gateway) porque es la puerta por la que salen tus datos cuando quieres ir a Internet (Google, YouTube, etc.). Si tu ordenador quiere "salir" de casa, envía la información al 10.50.0.1.</pagina_seis_caracteristica>
                        </pagina_seis_punto_caracteristica>
                    </pagina_seis_puntos_caracteristicas>
                </pagina_seis_caracteristica_adaptador>

            </pagina_seis_caracteristicas_adaptador>
        </pagina_seis_adaptador>

        <!-- COMO CONFIGURAR LA RED ("El cuadro de Propiedades") -->
        <pagina_seis_configuracion_red>
            <pagina_seis_titulo_configuracion_red>Para CONFIGURAR la red (El "Cuadro de Propiedades")</pagina_seis_titulo_configuracion_red>
            <pagina_seis_descripcion_configuracion_red>Si lo que necesitas es abrir la ventana donde se cambian manualmente las IPs o las DNS, el método más rápido en cualquier versión de Windows (10 u 11) es usar un atajo:</pagina_seis_descripcion_configuracion_red>

            <pagina_seis_atajos_configuracion_red>
                <pagina_seis_atajo_configuracion_red>
                    <pagina_seis_atajo>En tu teclado, mantén pulsada la tecla Windows y pulsa la tecla R (Windows + R). Se abrirá una ventanita pequeña llamada "Ejecutar".</pagina_seis_atajo>
                </pagina_seis_atajo_configuracion_red>

                <pagina_seis_atajo_configuracion_red>
                    <pagina_seis_atajo>Escribe el siguiente comando tal cual y pulsa Aceptar: ncpa.cpl</pagina_seis_atajo>
                </pagina_seis_atajo_configuracion_red>

                <pagina_seis_atajo_configuracion_red>
                    <pagina_seis_atajo>Se abrirá una ventana con tus iconos de red (Wi-Fi, Ethernet, Bluetooth).</pagina_seis_atajo>
                </pagina_seis_atajo_configuracion_red>

                <pagina_seis_atajo_configuracion_red>
                    <pagina_seis_atajo>Haz clic derecho sobre tu adaptador (en tu caso, el que dice "Wi-Fi") y selecciona Propiedades.</pagina_seis_atajo>
                </pagina_seis_atajo_configuracion_red>

                <pagina_seis_atajo_configuracion_red>
                    <pagina_seis_atajo>En la lista, busca Protocolo de Internet versión 4 (TCP/IPv4) y haz doble clic sobre él.</pagina_seis_atajo>
                </pagina_seis_atajo_configuracion_red>
            </pagina_seis_atajos_configuracion_red>

            <pagina_seis_pasos_configuraciones_red>
                <pagina_seis_pasos_configuracion_red>
                    <pagina_seis_paso_descripcion>¿Qué puedes hacer aquí? En esa ventana verás que probablemente está marcado "Obtener una dirección IP automáticamente". Si necesitas configurar una red de área local fija, ahí es donde seleccionarías "Usar la siguiente dirección IP" para copiar los datos que viste antes (Dirección IP, Máscara, Puerta de enlace)</pagina_seis_paso_descripcion>
                    <pagina_seis_imagenes_paso>
                        <pagina_seis_imagen_paso>pagina_seis_conexiones_red.png</pagina_seis_imagen_paso>
                    </pagina_seis_imagenes_paso>
                </pagina_seis_pasos_configuracion_red>

                <pagina_seis_pasos_configuracion_red>
                    <pagina_seis_paso_descripcion>Botón derecho en la red wifi, y botón derecho en TCP IPv4</pagina_seis_paso_descripcion>
                    <pagina_seis_imagenes_paso>
                        <pagina_seis_imagen_paso>pagina_seis_propiedades_wifi.png</pagina_seis_imagen_paso>
                    </pagina_seis_imagenes_paso>
                    <pagina_seis_imagenes_paso>
                        <pagina_seis_imagen_paso>pagina_seis_propiedades_ipv4.png</pagina_seis_imagen_paso>
                    </pagina_seis_imagenes_paso>
                </pagina_seis_pasos_configuracion_red>

                <pagina_seis_pasos_configuracion_red>
                    <pagina_seis_paso_descripcion>Opciones avanzadas</pagina_seis_paso_descripcion>
                    <pagina_seis_imagenes_paso>
                        <pagina_seis_imagen_paso>pagina_seis_opciones_avanzadas.png</pagina_seis_imagen_paso>
                    </pagina_seis_imagenes_paso>
                </pagina_seis_pasos_configuracion_red>

                <pagina_seis_pasos_configuracion_red>
                    <pagina_seis_paso_descripcion>Opción IPv6.</pagina_seis_paso_descripcion>
                    <pagina_seis_imagenes_paso>
                        <pagina_seis_imagen_paso>pagina_seis_propiedades_ipv6.png</pagina_seis_imagen_paso>
                    </pagina_seis_imagenes_paso>
                </pagina_seis_pasos_configuracion_red>
            </pagina_seis_pasos_configuraciones_red>

            <pagina_seis_pasos_conexiones_red>
                <pagina_seis_titulo_pasos_conexiones_red>Conexiones de red:</pagina_seis_titulo_pasos_conexiones_red>
                
                <pagina_seis_bloque_pasos_conexiones_red>
                    <pagina_seis_descripcion_paso_conexiones_red>Dale a boton derecho en el simbolo de windows y ve a conexiones de red.</pagina_seis_descripcion_paso_conexiones_red>
                    <pagina_seis_conjuntos_objetos_conexiones_red>
                        <pagina_seis_conjunto_objetos_conexiones_red>
                            <pagina_seis_objeto_conexiones_red>pagina_seis_barra_conexiones_red.png</pagina_seis_objeto_conexiones_red>
                        </pagina_seis_conjunto_objetos_conexiones_red>

                        <pagina_seis_conjunto_objetos_conexiones_red>
                            <pagina_seis_objeto_conexiones_red>pagina_seis_red_internet.png</pagina_seis_objeto_conexiones_red>
